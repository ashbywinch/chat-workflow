# .gitignore — the house set, curated.
#
# DO NOT CHANGE:
# - Never ignore lockfiles (uv.lock) — committed for reproducibility.
# - Test fixtures are committed under tests/, never ignored.

# env/secrets
.env
.env.local
*.keystore

# envs/deps
.venv/
venv/
ENV/
env/
node_modules/
dist/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/

# caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
coverage.xml
.tox/
.nox/

# build artifacts
*.egg-info/
*.egg

# agent/tool state
.sisyphus/
.opencode/
.code-review-graph/
.logs/
.tools/

# IDE/OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Project specific
*.log
evaluation_criteria.json
test-results/
