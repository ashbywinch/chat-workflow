# .env.example — every env var documented, values blank.
#
# Real values live in the shell environment or in the untracked `.env`.
# `make setup` copies this file to `.env` when it is missing. The library's
# `load_dotenv()` loads `.env`; real environment variables win.

# LLM provider — Cloudflare AI Gateway (OpenCode primary, DeepSeek fallback).
# The gateway owns the provider keys (BYOK), so the app only needs the
# gateway token. Text route: dynamic/fallback2 (set in config.json).
# Get the account ID and gateway name from the Cloudflare dashboard
# (AI -> AI Gateway) — see skill://cloudflare-ai-gateway.
OPENAI_BASE_URL=https://gateway.ai.cloudflare.com/v1/{ACCOUNT_ID}/{GATEWAY}/compat
OPENAI_API_KEY=

# Only needed when the `openrouter` preset is active in config.json.
# OPENROUTER_API_KEY=
